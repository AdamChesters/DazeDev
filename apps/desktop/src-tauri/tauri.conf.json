{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DazeDev",
  "version": "0.3.7-alpha.0",
  "identifier": "com.adamchesters.dazedev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DazeDev",
        "width": 1440,
        "height": 920,
        "maximized": true,
        "minWidth": 800,
        "minHeight": 540,
        "backgroundColor": "#151616",
        "create": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; font-src 'self'; media-src 'self' blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Terminal and tmux workspace",
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "runtime/": "runtime/",
      "licenses/": "licenses/"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
