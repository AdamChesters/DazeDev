{
  "name": "dazedev-monorepo",
  "private": true,
  "scripts": {
    "dev": "npm --prefix apps/desktop run dev",
    "build": "npm --prefix apps/desktop run build",
    "check": "npm --prefix apps/desktop run check",
    "test": "npm --prefix apps/desktop test",
    "gate": "npm --prefix apps/desktop run gate",
    "tauri": "npm --prefix apps/desktop run tauri",
    "test:host": "python3 -m unittest discover -s apps/desktop/tests -p test_*.py",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml --no-default-features --locked"
  }
}
